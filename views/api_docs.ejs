<%
  const safeAppName = (typeof appName === 'string' && appName) ? appName : 'EmbedCDN';
  const safeFavicon = (typeof appFavicon === 'string' && appFavicon) ? appFavicon : '/assets/logo.ico';
  const safeBaseUrl = (typeof appBaseUrl === 'string' && appBaseUrl) ? appBaseUrl.replace(/\/$/, '') : 'https://yourdomain.com';
  const safeUploadEndpoint = (typeof docsUploadEndpoint === 'string' && docsUploadEndpoint) ? docsUploadEndpoint : safeBaseUrl + '/api/upload';
  const safeHealthEndpoint = (typeof docsHealthEndpoint === 'string' && docsHealthEndpoint) ? docsHealthEndpoint : safeBaseUrl + '/api/health';
  const safeFileField = (typeof docsFileField === 'string' && docsFileField) ? docsFileField : 'file';
  const safeAuthHeader = (typeof docsAuthHeader === 'string' && docsAuthHeader) ? docsAuthHeader : 'x-api-token';
  const safeSampleToken = (typeof docsSampleToken === 'string' && docsSampleToken) ? docsSampleToken : 'YOUR_API_TOKEN';
  const safeSampleSlug = (typeof docsSampleSlug === 'string' && docsSampleSlug) ? docsSampleSlug : 'launch-assets';
  const safeGithub = (typeof githubInvite === 'string' && githubInvite) ? githubInvite : 'https://github.com/notysozu/EmbedCDN';

  const defaultResponse = {
    ok: true,
    data: {
      fileName: 'screenshot.png',
      originalName: 'screenshot.png',
      fileSize: '184 KB',
      fileLink: safeBaseUrl + '/files/screenshot.png',
      shortLink: safeBaseUrl + '/s/' + safeSampleSlug,
      shortCode: safeSampleSlug,
      directLink: safeBaseUrl + '/uploads/screenshot.png',
      title: 'Launch Poster',
      description: 'Tiny link. Big preview.'
    }
  };

  const responseJson = JSON.stringify(
    (typeof docsResponseExample === 'object' && docsResponseExample !== null)
      ? docsResponseExample
      : defaultResponse,
    null,
    2
  );

  const curlExample = `curl -X POST ${safeUploadEndpoint} \\
  -H "${safeAuthHeader}: ${safeSampleToken}" \\
  -F "${safeFileField}=@screenshot.png" \\
  -F "title=Launch Poster" \\
  -F "description=Tiny link. Big preview." \\
  -F "customSlug=${safeSampleSlug}"`;

  const fetchExample = `const form = new FormData();
form.append("${safeFileField}", fileInput.files[0]);
form.append("title", "Launch Poster");
form.append("description", "Tiny link. Big preview.");
form.append("customSlug", "${safeSampleSlug}");

const response = await fetch("${safeUploadEndpoint}", {
  method: "POST",
  headers: {
    "${safeAuthHeader}": "${safeSampleToken}"
  },
  body: form
});

const result = await response.json();
console.log("Hosted file link:", result.data.fileLink);
console.log("Short redirect link:", result.data.shortLink);`;

  const nodeExample = `import { readFile } from "node:fs/promises";

const fileBuffer = await readFile("./screenshot.png");
const form = new FormData();
form.append("${safeFileField}", new Blob([fileBuffer]), "screenshot.png");
form.append("title", "Launch Poster");
form.append("customSlug", "${safeSampleSlug}");

const response = await fetch("${safeUploadEndpoint}", {
  method: "POST",
  headers: {
    "${safeAuthHeader}": "${safeSampleToken}"
  },
  body: form
});

const result = await response.json();
console.log(result.data);`;

  const pythonExample = `import requests

url = "${safeUploadEndpoint}"
headers = {
    "${safeAuthHeader}": "${safeSampleToken}"
}

data = {
    "title": "Launch Poster",
    "description": "Tiny link. Big preview.",
    "customSlug": "${safeSampleSlug}"
}

with open("screenshot.png", "rb") as file_handle:
    files = {
        "${safeFileField}": ("screenshot.png", file_handle, "image/png")
    }
    response = requests.post(url, headers=headers, data=data, files=files)

print(response.json())`;

  const phpExample = `<?php
$ch = curl_init();
$file = new CURLFile('screenshot.png', 'image/png', 'screenshot.png');

curl_setopt_array($ch, [
  CURLOPT_URL => '${safeUploadEndpoint}',
  CURLOPT_POST => true,
  CURLOPT_RETURNTRANSFER => true,
  CURLOPT_HTTPHEADER => [
    '${safeAuthHeader}: ${safeSampleToken}'
  ],
  CURLOPT_POSTFIELDS => [
    '${safeFileField}' => $file,
    'title' => 'Launch Poster',
    'customSlug' => '${safeSampleSlug}'
  ]
]);

$response = curl_exec($ch);
curl_close($ch);
echo $response;`;

  const javaExample = `// Java 11+ HttpClient Multipart Pattern
HttpRequest request = HttpRequest.newBuilder()
    .uri(URI.create("${safeUploadEndpoint}"))
    .header("${safeAuthHeader}", "${safeSampleToken}")
    .header("Content-Type", "multipart/form-data; boundary=" + boundary)
    .POST(publishMultipart(Map.of(
        "${safeFileField}", Path.of("screenshot.png"),
        "title", "Launch Poster",
        "customSlug", "${safeSampleSlug}"
    )))
    .build();

HttpResponse<String> response = HttpClient.newHttpClient()
    .send(request, HttpResponse.BodyHandlers.ofString());

System.out.println(response.body());`;

  const goExample = `package main

import (
  "bytes"
  "fmt"
  "io"
  "mime/multipart"
  "net/http"
  "os"
)

func main() {
  body := &bytes.Buffer{}
  writer := multipart.NewWriter(body)

  part, _ := writer.CreateFormFile("${safeFileField}", "screenshot.png")
  file, _ := os.Open("screenshot.png")
  defer file.Close()
  io.Copy(part, file)

  writer.WriteField("title", "Launch Poster")
  writer.WriteField("customSlug", "${safeSampleSlug}")
  writer.Close()

  req, _ := http.NewRequest("POST", "${safeUploadEndpoint}", body)
  req.Header.Set("Content-Type", writer.FormDataContentType())
  req.Header.Set("${safeAuthHeader}", "${safeSampleToken}")

  resp, _ := http.DefaultClient.Do(req)
  defer resp.Body.Close()
  respBody, _ := io.ReadAll(resp.Body)
  fmt.Println(string(respBody))
}`;

  const discordExample = `const { AttachmentBuilder } = require('discord.js');

// Example: Uploading attachment from Discord message
async function hostDiscordAttachment(attachment, apiToken) {
  const fileRes = await fetch(attachment.url);
  const blob = await fileRes.blob();

  const form = new FormData();
  form.append('${safeFileField}', blob, attachment.name);
  form.append('title', attachment.name);

  const uploadRes = await fetch('${safeUploadEndpoint}', {
    method: 'POST',
    headers: { '${safeAuthHeader}': apiToken },
    body: form
  });

  const { data } = await uploadRes.json();
  return data.fileLink; // Rich Discord embed preview URL
}`;
%>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>API Documentation &mdash; <%= safeAppName %></title>
  <meta name="description" content="Integrate file uploads, branded short link generation, and rich Discord Open Graph embeds via REST API.">

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">

  <!-- Favicons -->
  <link rel="icon" type="image/x-icon" href="<%= safeFavicon %>">

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/assets/vendor/bootstrap-icons/bootstrap-icons.css">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>

