                <span>Check API Status</span>
              </button>
            </div>

            <div class="docs-status-grid" style="margin-top: 18px;">
              <div class="docs-status-item">
                <strong>Status</strong>
                <span data-api-health-status>Idle</span>
              </div>
              <div class="docs-status-item">
                <strong>Roundtrip Latency</strong>
                <span data-api-health-latency>Not checked yet</span>
              </div>
              <div class="docs-status-item">
                <strong>Server Timestamp</strong>
                <span data-api-health-time>Waiting for check</span>
              </div>
            </div>

            <pre class="docs-code-block docs-result-json" style="margin-top: 14px;"><code data-api-health-json>{
  "ok": true,
  "service": "<%= safeAppName %> API",
  "time": "ISO_TIMESTAMP"
}</code></pre>
          </div>
        </section>

        <!-- Error Handling -->
        <section class="docs-section reveal" id="errors">
          <div class="section-heading">
            <span class="eyebrow">Status Codes</span>
            <h2>Common API error codes & remedies</h2>
          </div>

          <div class="docs-errors-grid">
            <article class="docs-card">
              <strong>401 Unauthorized</strong>
              <p>The <code><%= safeAuthHeader %></code> token is missing or invalid. Verify your server token configuration.</p>
            </article>

            <article class="docs-card">
              <strong>400 Bad Request</strong>
              <p>No file binary attached to field <code><%= safeFileField %></code> or invalid form payload.</p>
            </article>

            <article class="docs-card">
              <strong>409 Conflict</strong>
              <p>The requested <code>customSlug</code> is already taken or collides with a reserved system route.</p>
            </article>

            <article class="docs-card">
              <strong>413 Payload Too Large</strong>
              <p>The uploaded file exceeds the configured server or storage limit.</p>
            </article>

            <article class="docs-card">
              <strong>500 Server Error</strong>
              <p>Storage provider or disk I/O error. Verify storage credentials and write permissions.</p>
            </article>
          </div>
        </section>

        <!-- Best Practices Notes -->
        <section class="docs-section reveal" id="notes">
          <div class="section-heading">
            <span class="eyebrow">Best Practices</span>
            <h2>Production recommendations</h2>
          </div>

          <div class="docs-card">
            <ul class="docs-list">
              <li>Use <code>shortLink</code> for clean sharing in chat messages, social posts, and dashboards.</li>
              <li>Use <code>fileLink</code> whenever Discord Open Graph crawler previews are required.</li>
              <li>Always validate custom slugs against alphanumeric characters (<code>[a-z0-9-]</code>).</li>
              <li>Rotate your API token immediately if it is exposed in client-side repositories.</li>
            </ul>
          </div>
        </section>
      </div>
    </section>
  </main>

