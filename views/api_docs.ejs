          <strong><%= safeAppName %></strong>
          <small>API Documentation</small>
        </span>
      </a>

      <button class="icon-button nav-toggle" type="button" data-nav-toggle aria-label="Toggle navigation" aria-expanded="false" aria-controls="primary-nav">
        <i class="bi bi-list" aria-hidden="true"></i>
      </button>

      <nav class="site-nav" id="primary-nav" data-nav-panel aria-label="Primary navigation">
        <a href="/">Home</a>
        <a href="/#upload">Upload</a>
        <a href="#quickstart">Quickstart</a>
