  <main class="docs-main">
    <section class="docs-hero">
      <div class="container docs-hero-grid">
        <div>
          <span class="eyebrow">REST Interface</span>
          <h1>Programmatic Upload & Embed API</h1>
          <p>
            Build direct file uploads into Discord bots, CLI tools, web apps, and build pipelines. Send a multipart POST request with your API token to receive both rich embed routes and branded short links.
          </p>
        </div>

        <div class="docs-hero-card">
          <div class="docs-stat-grid">
            <div class="docs-stat">
              <strong>Auth Method</strong>
              <span>Header: <code><%= safeAuthHeader %></code></span>
            </div>
            <div class="docs-stat">
              <strong>Payload Format</strong>
              <span>multipart/form-data</span>
            </div>
            <div class="docs-stat">
              <strong>Default Slug Length</strong>
              <span>6 alphanumeric chars</span>
            </div>
            <div class="docs-stat">
              <strong>Storage Parity</strong>
              <span>Local Disk & Vercel Blob</span>
            </div>
          </div>

          <div class="notice-card is-info">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <div>
              <strong>Instant Live Embeds</strong>
              <p>The returned <code>fileLink</code> is tuned for Discord Open Graph crawlers to render rich inline previews.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container docs-shell">
